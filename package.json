{
  "name": "rehab-neon-rider",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A neon cycling adventure powered by Rehab ESP32 WebBLE",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": { "three": "0.186.1" },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/three": "0.186.0",
    "@types/web-bluetooth": "0.0.22",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
